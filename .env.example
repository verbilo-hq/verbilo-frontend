# Local API. Set this to the deployed HTTPS API origin in production.
VITE_API_BASE=http://localhost:3000
VITE_COGNITO_USER_POOL_ID=eu-north-1_devmockpool
VITE_COGNITO_CLIENT_ID=verbilo-dev-client
VITE_AWS_REGION=eu-north-1
# Development only; omit from production builds.
VITE_MOCK_COGNITO_URL=http://localhost:9229
# VITE_MOCK_LATENCY=0

# Optional production-owned destinations. Leave unset to render an honest,
# non-clickable local fallback rather than a dead or invented link.
# VITE_BOOK_DEMO_URL=https://booking.example.com/...
# VITE_CONTACT_URL=https://www.example.com/contact
# VITE_PASSWORD_RECOVERY_URL=https://your-cognito-recovery-or-support-route
